# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹)에서 복사한 값을 넣고, 이 파일을 .env.local 로 복사합니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 진행자(관리자) 계정 이메일. database.rules.json 안의 이메일과 반드시 같아야 합니다.
VITE_ADMIN_EMAIL=

# GitHub Pages 하위 경로. 저장소 이름이 다르면 바꿉니다. (기본값 /brave-new-world/)
# VITE_BASE=/brave-new-world/
