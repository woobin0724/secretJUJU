{
  "name": "secretjuju",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "media": "node scripts/prepare-media.mjs",
    "predev": "node scripts/prepare-media.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-media.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:rules": "firebase emulators:exec --only auth,database --project demo-bnw \"vitest run --config vitest.rules.config.ts\"",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/noto-serif-kr": "^5.3.1",
    "firebase": "^12.19.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.36.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
